{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awesome-graph-mamba/data/schema.json",
  "title": "Graph Mamba survey paper record",
  "description": "Schema of one entry of data/papers.yaml. Bibliographic metadata is resolved from source/references.bib and is therefore not part of this schema. Enumerations mirror data/taxonomy.yaml; validate.py additionally cross-checks them against that file.",
  "type": "object",
  "required": ["key", "model", "roles", "sections", "methodology", "verification"],
  "additionalProperties": false,
  "properties": {
    "key": {"type": "string", "pattern": "^[A-Za-z0-9_:+\\-.]+$", "description": "BibTeX key (unique identifier)."},
    "model": {"type": "string", "minLength": 1, "description": "Model name as used in the survey."},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["taxonomy", "application", "discussed"]}
    },
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Manuscript labels where the work is discussed."},
    "precursor": {"type": "boolean", "description": "Structured-SSM precursor without input-dependent selection."},
    "multimodal": {"type": "boolean"},
    "taxonomy": {
      "type": "object",
      "required": ["setting", "d1", "d2", "d3", "d4"],
      "additionalProperties": false,
      "properties": {
        "setting": {"enum": ["static_general", "dynamic_spatiotemporal", "heterogeneous_higher_order"]},
        "d1": {"type": "string", "minLength": 1},
        "d2": {"type": "string", "minLength": 1},
        "d3": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["input", "dynamics", "operator"]}},
        "d4": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["standalone", "sequential", "parallel", "embedded"]}}
      }
    },
    "application": {
      "type": "object",
      "required": ["domain", "subdomain", "task", "graph_construction", "division_of_labor", "patterns", "dominant_pattern"],
      "additionalProperties": false,
      "properties": {
        "domain": {"type": "string"},
        "subdomain": {"type": "string"},
        "task": {"type": "string"},
        "graph_construction": {"type": "string"},
        "division_of_labor": {"type": "string"},
        "patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DV", "RT", "GS", "LG"]}},
        "dominant_pattern": {"enum": ["DV", "RT", "GS", "LG"]},
        "secondary_pattern": {"enum": ["DV", "RT", "GS", "LG"]}
      }
    },
    "methodology": {"type": "string", "minLength": 1},
    "contributions": {"type": "array", "items": {"type": "string"}},
    "complexity": {"type": "string"},
    "efficiency": {
      "type": "object",
      "required": ["scaling", "additional_costs", "evidence"],
      "additionalProperties": false,
      "properties": {
        "scaling": {"type": "string"},
        "additional_costs": {"type": "string"},
        "evidence": {"type": "string"}
      }
    },
    "expressivity": {
      "type": "object",
      "required": ["permutation_property", "result", "caveat"],
      "additionalProperties": false,
      "properties": {
        "permutation_property": {"type": "string"},
        "result": {"type": "string"},
        "caveat": {"type": "string"}
      }
    },
    "advantages": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "code": {"type": "string", "description": "Official implementation URL, only if stated in the survey or verified by an author."},
    "notes": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["extracted", "needs_verification", "verified"]},
        "verified_by": {"type": "string"},
        "date": {"type": "string"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "override_reason": {"type": "string", "description": "Required when a verified record intentionally differs from the manuscript tables."}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"roles": {"contains": {"const": "taxonomy"}}}}, "then": {"required": ["taxonomy"]}},
    {"if": {"properties": {"roles": {"contains": {"const": "application"}}}}, "then": {"required": ["application"]}}
  ]
}
